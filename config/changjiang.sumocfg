<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="changjiang.net.xml"/>
        <route-files value="routes_final.rou.xml"/>
        <additional-files value="signal_optimized.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>
    <processing>
        <time-to-teleport value="-1"/>
        <no-step-log value="true"/>
    </processing>
</configuration>
